{
  "name": "safe-environment",
  "displayName": "Safe Environment",
  "description": "Warns before opening .env files to prevent token leaks during livestreams",
  "version": "2.0.0",
  "publisher": "antoinedespres",
  "author": {
    "name": "Antoine Després"
  },
  "license": "MIT",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/antoinedespres/safe-environment.git"
  },
  "bugs": {
    "url": "https://github.com/antoinedespres/safe-environment/issues"
  },
  "keywords": [
    "env",
    "environment",
    "security",
    "privacy",
    "livestream",
    "streaming",
    "secrets"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "*"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "safeEnvironment.openSettings",
        "title": "Safe Environment: Open Settings"
      },
      {
        "command": "safeEnvironment.quickToggle",
        "title": "Safe Environment: Quick Toggle Patterns"
      }
    ],
    "configuration": {
      "title": "Safe Environment",
      "properties": {
        "safeEnvironment.additionalPatterns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Additional file patterns to intercept (regex strings). Example: `[\"secret\\\\.yaml$\", \"private\\\\.json$\"]`"
        },
        "safeEnvironment.disabledPatterns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Built-in patterns to disable (regex strings). Example: `[\"\\\\.npmrc$\"]` to allow `.npmrc` files"
        },
        "safeEnvironment.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable or disable the Safe Environment extension"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^5.3.0"
  }
}
